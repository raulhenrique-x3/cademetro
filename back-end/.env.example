# Connection string for PostgreSQL (host port 5434 via docker compose up db)
DATABASE_URL="postgresql://cademetro:cademetro@localhost:5434/cademetro"
DATABASE_URL_TEST="postgresql://cademetro:cademetro@localhost:5434/cademetro_test"
JWT_SECRET="your-secret-jwt-key"
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=8006
CORS_ORIGIN="*"

# Google OAuth (login social)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# URL pública de callback registrada no console do Google (ex: seu ngrok/domínio + /auth/google/callback)
GOOGLE_CALLBACK_URL="https://SEU_DOMINIO.ngrok-free.app/auth/google/callback"
# Para onde o app redireciona após o login com os tokens (deep link do app)
OAUTH_REDIRECT_URL="cademetro://auth/callback"
