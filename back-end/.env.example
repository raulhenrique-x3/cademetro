# Conexão dentro da rede do docker compose (host = db, porta interna 5432)
DATABASE_URL="postgresql://cademetro:CHANGE-ME@db:5432/cademetro"
# Conexão para testes na máquina host (porta publicada 5434 do container do banco)
DATABASE_URL_TEST="postgresql://cademetro:CHANGE-ME@localhost:5434/cademetro_test"
POSTGRES_USER=cademetro
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=cademetro
JWT_SECRET="your-secret-jwt-key"
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=8006
CORS_ORIGIN="*"

# Google OAuth (login social)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# URL pública de callback registrada no console do Google (deve ser exatamente a mesma do OAuth client)
GOOGLE_CALLBACK_URL="https://SEU_DOMINIO.ngrok-free.app/auth/google/callback"
# Para onde o app redireciona após o login com os tokens (deep link do app)
OAUTH_REDIRECT_URL="cademetro://auth/callback"